# Copy to .env for local development (never commit .env)

# --- Application ---
APP_NAME=support-ops-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OpenAI (required for local env-based secrets) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-nano

# --- Secrets loading: env | aws_secrets_manager | auto ---
SECRETS_SOURCE=env

# --- AWS (production-style settings; used when SECRETS_SOURCE includes AWS) ---
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_SECRET_NAME=support-ops-agent/openai

# --- Logging ---
ENABLE_CLOUDWATCH_LOGGING=false
CLOUDWATCH_LOG_GROUP=/support-ops/agent
CLOUDWATCH_LOG_STREAM_PREFIX=agent
# Max characters per field for user query / LLM / draft text in JSON logs (stdout + CloudWatch)
# AGENT_IO_LOG_MAX_CHARS=4000
# Structured LangChain/LangGraph span logs (stdout / same CloudWatch path as above when watchtower is on)
ENABLE_LANGCHAIN_TRACE_LOGS=false

# --- LangSmith (optional; LangChain/LangGraph tracing — same UX as LangSmith docs) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...   # or LANGSMITH_API_KEY
# LANGCHAIN_PROJECT=support-ops-agent

# --- Optional ---
# REDIS_URL=redis://localhost:6379/0
REQUEST_TIMEOUT_SECONDS=120

# --- Classroom demos (policy node only; keep false in real production) ---
# ENABLE_DEMO_SCENARIOS=false
# Include in user_query: [demo:tool-failure] → simulated error, or [demo:slow-tool] → sleep before policy search
# DEMO_SLOW_TOOL_DELAY_SECONDS=12
